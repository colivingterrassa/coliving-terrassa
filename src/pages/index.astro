<script is:inline set:html={`window.FOTOS=${FOTOS_JSON};
function coverHtml(kind, key, seed, label, style, clickable){
  var imgs = ((window.FOTOS||{})[kind]||{})[key] || [];
  var st = style ? ' style="'+style+'"' : '';
  if(imgs.length){
    if(clickable) return '<img class="ph-real lb-open" data-kind="'+kind+'" data-key="'+key+'" data-idx="0" style="cursor:zoom-in" src="'+imgs[0]+'" alt="'+label+'" loading="lazy">';
    return '<img class="ph-real" src="'+imgs[0]+'" alt="'+label+'" loading="lazy">';
  }
  return '<div class="ph ph--'+(seed%5)+'"'+st+'>'+label+'</div>';
}
function galeriaHtml(kind, key){
  var imgs = ((window.FOTOS||{})[kind]||{})[key] || [];
  if(imgs.length<2) return '';
  return '<div class="fgal">'+imgs.slice(1).map(function(f,i){
    return '<img class="lb-open" data-kind="'+kind+'" data-key="'+key+'" data-idx="'+(i+1)+'" src="'+f+'" alt="" loading="lazy">';
  }).join('')+'</div>';
}
document.addEventListener('click', function(e){
  var t = e.target.closest && e.target.closest('.lb-open');
  if(t){ e.stopPropagation(); obrirLightbox(t.getAttribute('data-kind'), t.getAttribute('data-key'), +t.getAttribute('data-idx')); }
});
var LB_IMGS=[], LB_IDX=0;
window.obrirLightbox=function(kind,key,idx){
  var imgs=((window.FOTOS||{})[kind]||{})[key]||[];
  if(!imgs.length) return;
  LB_IMGS=imgs; LB_IDX=idx||0;
  lbRender();
  document.getElementById('lightbox').hidden=false;
  document.body.style.overflow='hidden';
};
function lbRender(){
  document.getElementById('lbImg').src=LB_IMGS[LB_IDX];
  document.getElementById('lbCt').textContent=(LB_IDX+1)+' / '+LB_IMGS.length;
  document.querySelector('.lb__prev').style.display = LB_IMGS.length<2 ? 'none' : 'grid';
  document.querySelector('.lb__next').style.display = LB_IMGS.length<2 ? 'none' : 'grid';
}
window.lbNext=function(ev){ if(ev)ev.stopPropagation(); LB_IDX=(LB_IDX+1)%LB_IMGS.length; lbRender(); };
window.lbPrev=function(ev){ if(ev)ev.stopPropagation(); LB_IDX=(LB_IDX-1+LB_IMGS.length)%LB_IMGS.length; lbRender(); };
window.lbTanca=function(){ document.getElementById('lightbox').hidden=true; document.body.style.overflow=''; };
document.addEventListener('keydown', function(e){
  var lb=document.getElementById('lightbox');
  if(lb && !lb.hidden){
    if(e.key==='Escape') lbTanca();
    if(e.key==='ArrowRight') lbNext();
    if(e.key==='ArrowLeft') lbPrev();
  }
});
(function(){
  var lbTouchX=null;
  document.addEventListener('DOMContentLoaded', function(){
    var lb=document.getElementById('lightbox');
    if(!lb) return;
    lb.addEventListener('touchstart', function(e){ lbTouchX=e.touches[0].clientX; }, {passive:true});
    lb.addEventListener('touchend', function(e){
      if(lbTouchX===null) return;
      var dx=e.changedTouches[0].clientX-lbTouchX;
      if(Math.abs(dx)>40){ if(dx<0) lbNext(); else lbPrev(); }
      lbTouchX=null;
    }, {passive:true});
  });
})();
function avatarHtml(name, style){
  var key=(name||'').trim().split(/\s+/)[0].toLowerCase();
  var src=(window.FOTOS.resenyes||{})[key];
  var st = style ? ' style="'+style+'"' : '';
  if(src) return '<img class="av"'+st+' src="'+src+'" alt="'+name+'">';
  return '<div class="av"'+st+'>'+name[0]+'</div>';
}
`}></script>
