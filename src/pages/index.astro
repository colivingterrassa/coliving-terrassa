function setIdioma(l){
  L=l; document.documentElement.lang=l;
  $$('#lang button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.l===l?'true':'false'));
  $$('[data-i]').forEach(el=>{
    const v=T[l][el.dataset.i];
    if(typeof v==='string') el.innerHTML=v;
  });
  // Selector de barri
  const sel=$('#fBarri'), val=sel.value;
  sel.innerHTML='<option value="">'+t('totBarri')+'</option>'+
    ['Centre','Sant Pere',"Ca n'Aurell",'Can Palet','Vallparadís'].map(b=>'<option>'+b+'</option>').join('');
  sel.value=val;
  // Estadístiques
  $('#sPisos').textContent=PISOS.length;
  $('#sHab').textContent=HAB.length;
  // Qui som
  $('#abP').innerHTML=T[l].abP.map(p=>'<p>'+p+'</p>').join('');
  const fNosaltres=((window.FOTOS||{}).nosaltres||[])[0], abImgEl=$('#abImg');
  if(fNosaltres){
    abImgEl.classList.add('ab__i--ph');
    abImgEl.innerHTML='<img class="ab__ph" src="'+fNosaltres+'" alt="'+t('abH')+'"><span class="ab__cap">'+t('abImg')+'</span>';
  } else {
    abImgEl.classList.remove('ab__i--ph');
    abImgEl.innerHTML=t('abImg');
  }
  // Ressenyes destacades (una per pis, les tres millors)
  $('#rvG').innerHTML=[REV[0],REV[2],REV[5]].map(r=>`
    <article class="rc"><div class="st">${'★'.repeat(r.r)}</div>
      <blockquote>${r.t[l]}</blockquote>
      <footer>${avatarHtml(esc(r.n))}
        <div><cite>${esc(r.n)}</cite><small>${esc(r.loc[l])}</small></div></footer></article>`).join('');
  // FAQs en dues columnes
  const fq=T[l].faqs, mid=Math.ceil(fq.length/2);
  const col=a=>a.map(([q,a2])=>`<div class="fitem">
      <button class="fq__q">${esc(q)}</button>
      <div class="fq__a"><p>${esc(a2)}</p></div></div>`).join('');
  $('#fqG').innerHTML='<div>'+col(fq.slice(0,mid))+'</div><div>'+col(fq.slice(mid))+'</div>';
  $$('.fq__q').forEach(b=>b.onclick=()=>b.parentElement.classList.toggle('on'));
  // Placeholders traduibles (inputs/textarea amb data-ph)
  $$('[data-ph]').forEach(el=>{el.placeholder=T[l][el.dataset.ph]||''});
  // Area de propietaris
  $('#ownModel').innerHTML=T[l].ownModel.map(x=>'<p style="color:var(--ink-2);margin-bottom:13px">'+x+'</p>').join('');
  $('#ownSteps').innerHTML=T[l].ownSteps.map(([a,b])=>
    '<div class="step"><div><b>'+esc(a)+'</b><span>'+esc(b)+'</span></div></div>').join('');
  $('#ownSvc').innerHTML=T[l].ownSvc.map(x=>'<div>'+esc(x)+'</div>').join('');
  const selOpts=(el,arr)=>{const v=el.selectedIndex;
    el.innerHTML=arr.map((o,i)=>'<option value="'+(i?esc(o):'')+'">'+esc(o)+'</option>').join('');
    el.selectedIndex=v>0?v:0};
  selOpts($('#pfHab'),T[l].pfHabOpts);
  selOpts($('#pfEstat'),T[l].pfEstatOpts);
  // Re-render de la vista activa
  if(PIS_OBERT) obrirPis(PIS_OBERT); else aplica();
}

/* =====================================================================
   10. EVENTS
   ===================================================================== */
/* Formulari de propietaris — independent del de llogaters.
   En connectar-ho a Supabase, ha d'anar a una taula 'leads_propietaris',
   no a 'leads_web': son dos embuts comercials diferents. */
$('#fProp').onsubmit=e=>{
  e.preventDefault();
  const d=new FormData(e.target), er=$('#ePro'); er.hidden=true;
  if((d.get('nom')||'').trim().length<2) return sErr(er,t('eNom'));
  if(!/^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(d.get('email')||'')) return sErr(er,t('eEmail'));
  if(!(d.get('zona')||'').trim()) return sErr(er,t('eZona'));
  if(!d.get('rgpd')) return sErr(er,t('eRgpd'));
  const btn=e.target.querySelector('button[type=submit]'); if(btn) btn.disabled=true;
  enviaFormulari({
    subject:'Nuevo propietario interesado — '+d.get('zona'),
    from_name:d.get('nom'), nom:d.get('nom'), email:d.get('email'), telefon:d.get('tel')||'',
    zona:d.get('zona'), habitacions:d.get('nhab')||'', estat:d.get('estat')||'',
    missatge:d.get('msg')||'', formulari:'Formulario de propietarios'
  }).then(ok=>{
    if(ok){
      const _pP=e.target.parentNode;
      e.target.outerHTML='<div class="okb"><strong>'+t('okPT')+'</strong>'+t('okPP')+'</div>';
      const _okP=_pP.querySelector('.okb'); if(_okP) _okP.scrollIntoView({behavior:'smooth',block:'center'});
    } else {
      if(btn) btn.disabled=false;
      sErr(er,t('eEnviament'));
    }
  });
};

$('#lang').onclick=e=>{const b=e.target.closest('button[data-l]');if(b)setIdioma(b.dataset.l)};
$('#fCerca').onsubmit=e=>{e.preventDefault();const f=filtres();
  f.barri=$('#fBarri').value;f.data=$('#fData').value;setF(f);
  if(PIS_OBERT)anarLlista();else aplica()};
function tancaDrops(except){
  $$('.fdrop.show').forEach(d=>{if(d!==except){d.classList.remove('show');
    d.previousElementSibling.setAttribute('aria-expanded','false')}});
}
$('#fbar').addEventListener('click',e=>{
  const btn=e.target.closest('.fbtn');
  if(btn){
    const drop=btn.nextElementSibling, open=drop.classList.contains('show');
    tancaDrops(open?null:drop);
    drop.classList.toggle('show', !open);
    btn.setAttribute('aria-expanded', (!open).toString());
    return;
  }
  const c=e.target.closest('.chip[data-f]');
  if(c){
    const f=filtres(),k=c.dataset.f;
    f[k]=f[k]===c.dataset.v?'':c.dataset.v;setF(f);aplica();
    tancaDrops(null);
  }
});
document.addEventListener('click',e=>{if(!e.target.closest('.fgrp2'))tancaDrops(null)});
$('#bRst').onclick=()=>{const f=filtres();
  history.replaceState(null,'',location.pathname);aplica()};
$('#sort').onchange=()=>{const f=filtres();f.sort=$('#sort').value;setF(f);aplica()};
$('#modal').onclick=e=>{if(e.target.dataset.close!==undefined)tanca()};
document.onkeydown=e=>{if(e.key==='Escape'){if(!$('#modal').hidden)tanca();else if(PIS_OBERT)anarLlista();else tancaDrops(null)}};

/* Arrencada */
function initMapa(){
  const el=document.getElementById('mapaLeaflet'); if(!el) return;
  try{
    var LL=window.L; // 'L' ja s'usa a la pagina per l'idioma actual; Leaflet viu a window.L
    if(typeof LL==='undefined' || typeof LL.map!=='function') throw new Error('Leaflet no disponible');
    const map=LL.map(el,{scrollWheelZoom:true});
    LL.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
      maxZoom:19, attribution:'&copy; OpenStreetMap'
    }).addTo(map);
    const markers=PISOS.map(p=>{
      const pm=preuMin(p.id);
      const label=pm?(pm+' €'):t('completa');
      const icon=LL.divIcon({
        className:'mapa__pin',
        html:'<div class="mapa__price">'+esc(label)+'</div>',
        iconSize:[0,0], iconAnchor:[0,0]
      });
      const m=LL.marker([p.lat,p.lng],{icon}).addTo(map);
      m.bindTooltip(esc(p.nom),{direction:'top',offset:[0,-42]});
      m.on('click',()=>obrirPis(p.id));
      return m;
    });
    map.fitBounds(LL.featureGroup(markers).getBounds().pad(0.25));
  }catch(err){
    el.innerHTML='<div class="mapa__fb">'+PISOS.map(p=>
      '<a href="https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(p.adreca+', Terrassa')+'" target="_blank" rel="noopener"><b>'+esc(p.nom)+'</b><small>'+esc(p.adreca)+'</small></a>'
    ).join('')+'</div>';
  }
}
setIdioma('ca');
ckInit();
initMapa();
const fIni=filtres();
if(fIni.pis && PISOS.some(p=>p.id===+fIni.pis)) obrirPis(+fIni.pis);

/* ---------- Scroll-spy al menu superior ---------- */
(function(){
  const navLinks=Array.from(document.querySelectorAll('.nav>a[href^="#"]'));
  const targets=navLinks.map(a=>({a,id:a.getAttribute('href').slice(1)}))
    .filter(x=>document.getElementById(x.id));
  if(!targets.length) return;
  const obs=new IntersectionObserver(entries=>{
    entries.forEach(en=>{
      if(en.isIntersecting){
        const hit=targets.find(x=>x.id===en.target.id);
        if(hit){ navLinks.forEach(a=>a.classList.remove('is-active')); hit.a.classList.add('is-active'); }
      }
    });
  },{rootMargin:'-45% 0px -50% 0px',threshold:0});
  targets.forEach(x=>obs.observe(document.getElementById(x.id)));
})();

/* ---------- Boto flotant "tornar amunt" ---------- */
(function(){
  const btn=document.getElementById('toTop'); if(!btn) return;
  let ticking=false;
  document.addEventListener('scroll',function(){
    if(ticking) return; ticking=true;
    requestAnimationFrame(function(){ btn.classList.toggle('show', window.scrollY>600); ticking=false; });
  },{passive:true});
  btn.onclick=function(){ window.scrollTo({top:0,behavior:'smooth'}); };
})();
</script>
