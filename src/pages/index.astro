/* =====================================================================
   3. ESTAT I UTILITATS
   ===================================================================== */
let L='ca', VISTA='list', PIS_OBERT=null, LLISTA_SCROLL=0;
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const t=k=>T[L][k]||k;
const fd=d=>{const p=d.split('-');return p[2]+'/'+p[1]+'/'+p[0].slice(2)};
const HOY=new Date().toISOString().slice(0,10);

const habsDe=id=>HAB.filter(h=>h.pis===id);
const lliuresDe=id=>habsDe(id).filter(h=>h.estat!=='ocupada');
const preuDes=id=>{const l=lliuresDe(id);return l.length?Math.min(...l.map(h=>h.preu)):null};
const preuMin=id=>{const l=habsDe(id).map(h=>h.preu);return l.length?Math.min(...l):null};
const revsDe=id=>REV.filter(r=>r.pis===id);

function estatHab(h){
  if(h.estat==='ocupada') return {c:'off',t:t('ocupada')};
  if(!h.des||h.des<=HOY)  return {c:'ok', t:t('dispAra')};
  return {c:'soon',t:t('dispDes')+' '+fd(h.des)};
}
function estatPis(id){
  const l=lliuresDe(id);
  if(!l.length) return {c:'off',t:t('completa')};
  if(l.some(h=>!h.des||h.des<=HOY)) return {c:'ok',t:t('dispAra')};
  const prox=l.map(h=>h.des).sort()[0];
  return {c:'soon',t:t('dispDes')+' '+fd(prox)};
}

/* =====================================================================
   4. FILTRES (sobre habitacions, resultat agregat a pisos)
   ===================================================================== */
function filtres(){
  const p=new URLSearchParams(location.search);
  return {barri:p.get('barri')||'',data:p.get('data')||'',preu:p.get('preu')||'',
          bany:p.get('bany')||'',tipus:p.get('tipus')||'',disp:p.get('disp')||'',
          comp:p.get('comp')||'',sort:p.get('sort')||'preu_asc',pis:p.get('pis')||''};
}
function setF(f){
  const p=new URLSearchParams();
  Object.entries(f).forEach(([k,v])=>{if(v&&!(k==='sort'&&v==='preu_asc'))p.set(k,v)});
  history.replaceState(null,'',p.toString()?'?'+p:location.pathname);
}
/* Nº de companys de pis = habitacions del pis - 1 (la teva)
   petit: fins a 2 companys (pisos de 2-3 hab)
   mitja: 3-4 companys      (pisos de 4-5 hab)
   gran : 5 o més companys  (pisos de 6+ hab) */
function passaComp(nhab,v){
  if(!v) return true;
  if(v==='petit') return nhab<=3;
  if(v==='mitja') return nhab>=4&&nhab<=5;
  return nhab>=6;
}
function passaPreu(preu,v){
  if(!v) return true;
  if(v==='h350') return preu<=350;
  if(v==='350-400') return preu>350&&preu<=400;
  return preu>400;
}
function passaDisp(h,v){
  if(!v) return true;
  const c=estatHab(h).c;
  if(v==='disponible') return c==='ok';
  if(v==='propera') return c==='soon';
  return c==='off';
}
function habPassa(h,f){
  const pis=PISOS.find(p=>p.id===h.pis);
  return (!f.barri||pis.barri===f.barri)&&(!f.bany||h.bany===f.bany)&&
         (!f.tipus||h.tipus===f.tipus)&&passaPreu(h.preu,f.preu)&&
         passaComp(pis.nhab,f.comp)&&
         passaDisp(h,f.disp)&&
         (!f.data||(h.estat!=='ocupada'&&(!h.des||h.des<=f.data)));
}
function pisosFiltrats(f){
  const ids=new Set(HAB.filter(h=>habPassa(h,f)).map(h=>h.pis));
  let r=PISOS.filter(p=>ids.has(p.id));
  const preu=p=>{const c=HAB.filter(h=>h.pis===p.id&&habPassa(h,f)).map(h=>h.preu);
                 return c.length?Math.min(...c):9999};
  const pes=p=>lliuresDe(p.id).length?0:1;
  if(f.sort==='preu_desc') r.sort((a,b)=>pes(a)-pes(b)||preu(b)-preu(a));
  else if(f.sort==='disp') r.sort((a,b)=>pes(a)-pes(b)||
    String(lliuresDe(a.id).map(h=>h.des||'0').sort()[0]).localeCompare(String(lliuresDe(b.id).map(h=>h.des||'0').sort()[0])));
  else r.sort((a,b)=>pes(a)-pes(b)||preu(a)-preu(b));
  return r;
}

/* =====================================================================
   5. RENDER — LLISTA DE PISOS
   ===================================================================== */
function pintaUI(f){
  $('#fBarri').value=f.barri; $('#fData').value=f.data; $('#sort').value=f.sort;
  $$('.chip[data-f]').forEach(c=>{
    c.setAttribute('aria-pressed', f[c.dataset.f]===c.dataset.v?'true':'false');
  });
  $$('.fgrp2[data-grp]').forEach(g=>{
    const btn=g.querySelector('.fbtn'), on=!!f[g.dataset.grp];
    btn.classList.toggle('active', on);
    const sel=on?g.querySelector('.chip[aria-pressed="true"]'):null;
    btn.textContent = sel ? sel.textContent : t(btn.dataset.i);
  });
  $('#bRst').hidden=!(f.barri||f.data||f.preu||f.bany||f.tipus||f.disp||f.comp);
}

function aplica(){
  const f=filtres(); pintaUI(f);
  const rows=pisosFiltrats(f);
  $('#rCount').innerHTML=rows.length
    ? rows.length+' '+(rows.length===1?t('pis'):t('pisos'))+' <span>'+t('aTerrassa')+'</span>'
    : t('emH');
  $('#empty').hidden = rows.length>0 || VISTA==='map';
  $('#grid').hidden  = VISTA==='map';
  $('#grid').innerHTML=rows.map((p,i)=>{
    const e=estatPis(p.id), nl=lliuresDe(p.id).length, pd=preuDes(p.id);
    return `<button class="card ${nl?'':'card--off'}" data-pis="${p.id}" style="animation-delay:${Math.min(i,8)*35}ms">
      <div class="card__m">${coverHtml('pisos', FOTOS.pisSlug[p.id], i, esc(p.nom))}
        <span class="bdg bdg--${e.c}">${e.t}</span>
        <span class="cnt">${nl} ${nl===1?t('hab'):t('habs')} ${nl===1?t('lliure'):t('lliures')}</span></div>
      <div class="card__b">
        <h3 class="card__t">${esc(p.nom)}</h3>
        <p class="card__l">${esc(p.barri)}, Terrassa · ${p.nrev?('<span class="rate"><span>★</span>'+p.rating.toFixed(1)+'</span>'):('<span class="rate rate--new">'+t('pisNou')+'</span>')}</p>
        <p class="card__meta"><span>${p.m2} m²</span><i></i><span>${p.nbany} ${t('banys')}</span><i></i><span>${p.nhab-1} ${p.nhab-1===1?t('company'):t('companys')}</span></p>
        <div class="card__f">
          <div class="price"><em>${t('desDe')}</em>${pd?pd+' €':'—'}<small>${t('mes')}</small></div>
          <span class="more">${t('veureMes')} →</span></div>
      </div></button>`}).join('');
  $$('.card[data-pis]').forEach(c=>c.onclick=()=>obrirPis(+c.dataset.pis));
}

