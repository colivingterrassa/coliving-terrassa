/* =====================================================================
   COOKIES · CONSENT MODE v2 (analítica només amb consentiment)
   ===================================================================== */
const CK_KEY='ct_consent', CK_DAYS=365;
function ckGet(){
  try{const o=JSON.parse(localStorage.getItem(CK_KEY)||'null');
    if(o&&(o.v==='all'||o.v==='none')&&Date.now()-o.t<CK_DAYS*864e5) return o.v;}catch(e){}
  return null;
}
function ckNetejaGA(){
  const dom=location.hostname.replace(/^www\./,'');
  document.cookie.split(';').forEach(c=>{
    const n=c.split('=')[0].trim();
    if(n==='_ga'||n.indexOf('_ga_')===0||n==='_gid'||n.indexOf('_gat')===0){
      ['','; domain='+dom,'; domain=.'+dom,'; domain=www.'+dom].forEach(d=>{
        document.cookie=n+'=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/'+d;
      });
    }
  });
}
function ckSet(v){
  try{localStorage.setItem(CK_KEY,JSON.stringify({v:v,t:Date.now()}));}catch(e){}
  if(v==='all'){ window.ckLoadGA&&ckLoadGA(); }
  else{ window['ga-disable-G-MXHGDY7B17']=true; window.gtag&&gtag('consent','update',{analytics_storage:'denied'}); ckNetejaGA(); }
  const b=$('#ck'); if(b) b.hidden=true;
}
function ckInit(){
  $('#ckY').onclick=()=>ckSet('all');
  $('#ckN').onclick=()=>ckSet('none');
  if(!ckGet()) $('#ck').hidden=false;
}
